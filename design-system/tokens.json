{
  "color-fg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0588, 0.0902, 0.1647], "hex": "#0f172a"}, "$description": "Primary text; pairs with color-bg (AA)"},
  "color-fg-muted": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.2784, 0.3333, 0.4118], "hex": "#475569"}, "$description": "Secondary text, hints, captions"},
  "color-bg": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}, "$description": "Page background"},
  "color-surface": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9451, 0.9608, 0.9765], "hex": "#f1f5f9"}, "$description": "Subtle surfaces and hover fills"},
  "color-border": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.7961, 0.8353, 0.8824], "hex": "#cbd5e1"}, "$description": "Default borders and dividers"},
  "color-border-strong": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.3922, 0.4549, 0.5451], "hex": "#64748b"}, "$description": "Form control borders"},
  "color-primary": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0549, 0.4549, 0.5647], "hex": "#0e7490"}, "$description": "Brand teal: primary actions, links, selection"},
  "color-primary-hover": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0824, 0.3686, 0.4588], "hex": "#155e75"}, "$description": "Primary hover/pressed"},
  "color-primary-subtle": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9255, 0.9961, 1], "hex": "#ecfeff"}, "$description": "Tint behind selected items"},
  "color-on-primary": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff"}, "$description": "Text on primary and danger fills"},
  "color-focus": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.1137, 0.3059, 0.8471], "hex": "#1d4ed8"}, "$description": "Focus ring"},
  "color-danger": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.7255, 0.1098, 0.1098], "hex": "#b91c1c"}, "$description": "Destructive actions and errors"},
  "color-danger-hover": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.6, 0.1059, 0.1059], "hex": "#991b1b"}, "$description": "Danger hover"},
  "color-danger-subtle": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9961, 0.949, 0.949], "hex": "#fef2f2"}, "$description": "Danger tint"},
  "color-success": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0824, 0.502, 0.2392], "hex": "#15803d"}, "$description": "Confirmed / success"},
  "color-success-subtle": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9412, 0.9922, 0.9569], "hex": "#f0fdf4"}, "$description": "Success tint"},
  "color-warning": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.5725, 0.251, 0.0549], "hex": "#92400e"}, "$description": "Needs attention"},
  "color-warning-subtle": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [1, 0.9843, 0.9216], "hex": "#fffbeb"}, "$description": "Warning tint"},
  "color-info": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0118, 0.4118, 0.6314], "hex": "#0369a1"}, "$description": "Informational"},
  "color-info-subtle": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.9412, 0.9765, 1], "hex": "#f0f9ff"}, "$description": "Info tint"},
  "color-overlay": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.0588, 0.0902, 0.1647], "hex": "#0f172a"}, "$description": "Scrim behind modals and drawers (used with opacity-overlay)"},
  "color-skeleton": {"$type": "color", "$value": {"colorSpace": "srgb", "components": [0.8863, 0.9098, 0.9412], "hex": "#e2e8f0"}, "$description": "Skeleton placeholder fill"},

  "space-1": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}, "$description": "Spacing step 1"},
  "space-2": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}, "$description": "Spacing step 2"},
  "space-3": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}, "$description": "Spacing step 3"},
  "space-4": {"$type": "dimension", "$value": {"value": 24, "unit": "px"}, "$description": "Spacing step 4"},
  "space-5": {"$type": "dimension", "$value": {"value": 32, "unit": "px"}, "$description": "Spacing step 5"},
  "space-6": {"$type": "dimension", "$value": {"value": 48, "unit": "px"}, "$description": "Spacing step 6"},
  "radius-sm": {"$type": "dimension", "$value": {"value": 4, "unit": "px"}, "$description": "Small radius: inputs, checkboxes"},
  "radius-md": {"$type": "dimension", "$value": {"value": 8, "unit": "px"}, "$description": "Medium radius: buttons, menus"},
  "radius-lg": {"$type": "dimension", "$value": {"value": 12, "unit": "px"}, "$description": "Large radius: cards, modals"},
  "radius-full": {"$type": "dimension", "$value": {"value": 9999, "unit": "px"}, "$description": "Pills and circles"},
  "font-size-sm": {"$type": "dimension", "$value": {"value": 14, "unit": "px"}, "$description": "Small text"},
  "font-size-md": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}, "$description": "Body text"},
  "font-size-lg": {"$type": "dimension", "$value": {"value": 20, "unit": "px"}, "$description": "Subheadings"},
  "font-size-xl": {"$type": "dimension", "$value": {"value": 28, "unit": "px"}, "$description": "Page headings"},
  "border-width": {"$type": "dimension", "$value": {"value": 1, "unit": "px"}, "$description": "Standard border width"},
  "border-width-strong": {"$type": "dimension", "$value": {"value": 2, "unit": "px"}, "$description": "Focus ring and selected indicators"},
  "size-control-sm": {"$type": "dimension", "$value": {"value": 32, "unit": "px"}, "$description": "Small control height"},
  "size-control-md": {"$type": "dimension", "$value": {"value": 40, "unit": "px"}, "$description": "Default control height"},
  "size-control-lg": {"$type": "dimension", "$value": {"value": 48, "unit": "px"}, "$description": "Large control height"},
  "size-check": {"$type": "dimension", "$value": {"value": 20, "unit": "px"}, "$description": "Checkbox / radio box"},
  "size-switch-width": {"$type": "dimension", "$value": {"value": 40, "unit": "px"}, "$description": "Switch track width"},
  "size-switch-height": {"$type": "dimension", "$value": {"value": 22, "unit": "px"}, "$description": "Switch track height"},
  "size-avatar": {"$type": "dimension", "$value": {"value": 40, "unit": "px"}, "$description": "Avatar diameter"},
  "size-spinner": {"$type": "dimension", "$value": {"value": 24, "unit": "px"}, "$description": "Spinner diameter"},
  "size-grid-min": {"$type": "dimension", "$value": {"value": 240, "unit": "px"}, "$description": "Minimum grid column width"},
  "size-menu-min": {"$type": "dimension", "$value": {"value": 200, "unit": "px"}, "$description": "Minimum menu width"},
  "size-drawer-width": {"$type": "dimension", "$value": {"value": 360, "unit": "px"}, "$description": "Drawer width"},
  "size-modal-width": {"$type": "dimension", "$value": {"value": 480, "unit": "px"}, "$description": "Modal max width"},
  "size-toast-width": {"$type": "dimension", "$value": {"value": 320, "unit": "px"}, "$description": "Toast max width"},
  "size-tooltip-max": {"$type": "dimension", "$value": {"value": 240, "unit": "px"}, "$description": "Tooltip max width"},
  "size-content-max": {"$type": "dimension", "$value": {"value": 72, "unit": "rem"}, "$description": "Max page content width"},
  "size-skeleton-line": {"$type": "dimension", "$value": {"value": 16, "unit": "px"}, "$description": "Skeleton line height"},
  "size-preview-frame": {"$type": "dimension", "$value": {"value": 360, "unit": "px"}, "$description": "Height of overlay preview frames in the style guide"},
  "breakpoint-md": {"$type": "dimension", "$value": {"value": 48, "unit": "rem"}, "$description": "Desktop-navigation breakpoint; documented here because media queries cannot read custom properties"},

  "font-family-sans": {"$type": "fontFamily", "$value": ["Inter", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"], "$description": "UI font"},
  "font-family-mono": {"$type": "fontFamily", "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"], "$description": "Code samples"},
  "font-weight-regular": {"$type": "fontWeight", "$value": 400, "$description": "Body"},
  "font-weight-medium": {"$type": "fontWeight", "$value": 500, "$description": "Labels and buttons"},
  "font-weight-bold": {"$type": "fontWeight", "$value": 700, "$description": "Headings"},
  "line-height-body": {"$type": "number", "$value": 1.5, "$description": "Body line height"},
  "line-height-tight": {"$type": "number", "$value": 1.25, "$description": "Headings"},
  "opacity-disabled": {"$type": "number", "$value": 0.5, "$description": "Disabled controls"},
  "opacity-overlay": {"$type": "number", "$value": 0.5, "$description": "Scrim opacity"},
  "z-dropdown": {"$type": "number", "$value": 10, "$description": "Dropdown layer"},
  "z-overlay": {"$type": "number", "$value": 100, "$description": "Backdrop layer"},
  "z-modal": {"$type": "number", "$value": 110, "$description": "Modal and drawer layer"},
  "z-toast": {"$type": "number", "$value": 120, "$description": "Toast and tooltip layer"},
  "duration-fast": {"$type": "duration", "$value": {"value": 150, "unit": "ms"}, "$description": "Transitions"},
  "duration-spin": {"$type": "duration", "$value": {"value": 800, "unit": "ms"}, "$description": "Spinner and skeleton cycle"},

  "button-primary-background": {"$type": "color", "$value": "{color-primary}", "$description": "Primary button fill"},
  "button-primary-foreground": {"$type": "color", "$value": "{color-on-primary}", "$description": "Primary button text"},
  "button-primary-hover": {"$type": "color", "$value": "{color-primary-hover}", "$description": "Primary button hover fill"},
  "button-secondary-background": {"$type": "color", "$value": "{color-surface}", "$description": "Secondary button fill"},
  "button-secondary-foreground": {"$type": "color", "$value": "{color-fg}", "$description": "Secondary button text"},
  "button-secondary-hover": {"$type": "color", "$value": "{color-border}", "$description": "Secondary button hover fill"},
  "button-secondary-border": {"$type": "color", "$value": "{color-border-strong}", "$description": "Secondary button border"},
  "button-ghost-background": {"$type": "color", "$value": "{color-bg}", "$description": "Ghost button fill"},
  "button-ghost-foreground": {"$type": "color", "$value": "{color-primary}", "$description": "Ghost button text"},
  "button-ghost-hover": {"$type": "color", "$value": "{color-surface}", "$description": "Ghost button hover fill"},
  "button-danger-background": {"$type": "color", "$value": "{color-danger}", "$description": "Danger button fill"},
  "button-danger-foreground": {"$type": "color", "$value": "{color-on-primary}", "$description": "Danger button text"},
  "button-danger-hover": {"$type": "color", "$value": "{color-danger-hover}", "$description": "Danger button hover fill"},
  "button-default-radius": {"$type": "dimension", "$value": "{radius-md}", "$description": "Button corner radius"},
  "button-default-padding": {"$type": "dimension", "$value": "{space-3}", "$description": "Button horizontal padding"},
  "card-default-background": {"$type": "color", "$value": "{color-bg}", "$description": "Card fill"},
  "card-default-border": {"$type": "color", "$value": "{color-border}", "$description": "Card border"},
  "card-default-radius": {"$type": "dimension", "$value": "{radius-lg}", "$description": "Card corner radius"},
  "card-default-padding": {"$type": "dimension", "$value": "{space-3}", "$description": "Card inner padding"}
}
