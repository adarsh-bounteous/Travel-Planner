{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "brand:assets": "node --experimental-strip-types scripts/build-brand-assets.ts",
    "bundle:measure": "node scripts/measure-bundle.mjs",
    "phase2:bundle": "node scripts/bundle-compare.mjs",
    "phase2:lighthouse": "node scripts/lighthouse-compare.mjs",
    "phase2:screenshots": "node scripts/capture-phase2.mjs",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "devloop": "tsc -b && vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "lighthouse": "^12.8.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.0.5"
  }
}
